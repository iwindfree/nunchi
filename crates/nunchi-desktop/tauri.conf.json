{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nunchi",
  "version": "0.1.0",
  "identifier": "dev.iwindfree.nunchi",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "nunchi",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
